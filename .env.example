# ============================================================================
# Biến môi trường của Shipping Service
# ============================================================================
# Sao chép file này thành .env khi chạy local.
# Không commit .env, password, token hoặc API key thật lên Git.
# Khi chạy Docker Compose/Kubernetes, dùng hostname của service thay localhost.

# ----------------------------------------------------------------------------
# 01. Runtime - HTTP API và log TypeORM
# ----------------------------------------------------------------------------
NODE_ENV=development                         # development | production
PORT=3012                                     # Port HTTP của Shipping Service
APP_VERSION=1.0.0                             # Version trả về trong health endpoint
TYPEORM_LOGGING=false                         # Bật log SQL khi cần debug

# ----------------------------------------------------------------------------
# 02. PostgreSQL - database riêng của Shipping Service
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost                       # Host PostgreSQL khi chạy local
POSTGRES_PORT=5432                            # Port PostgreSQL
POSTGRES_USER=bin_ecommerce                   # User kết nối database
POSTGRES_PASSWORD=
POSTGRES_DB=bin_shipping                      # Tên database shipping

# ----------------------------------------------------------------------------
# 03. Service nội bộ - order và seller
# ----------------------------------------------------------------------------
ORDER_SERVICE_URL=http://localhost:3011       # URL Order Service khi chạy local
SELLER_SERVICE_URL=http://localhost:3007      # URL Seller Service khi chạy local
INTERNAL_SERVICE_TOKEN=

# ----------------------------------------------------------------------------
# 04. Kafka - event đồng bộ vận chuyển
# ----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:29092                 # Danh sách broker, phân tách bằng dấu phẩy
KAFKA_CLIENT_ID=shipping-service              # Định danh Kafka client
KAFKA_GROUP_ID=shipping-service               # Consumer group của Shipping Service

# ----------------------------------------------------------------------------
# 05. GHN Test Provider - tích hợp vận chuyển cho demo
# ----------------------------------------------------------------------------
# Chỉ dùng GHN Test trong phase hiện tại; không đưa token thật vào Git.
GHN_BASE_URL=https://dev-online-gateway.ghn.vn # Endpoint GHN Test
GHN_TOKEN=
GHN_SHOP_ID=
GHN_CLIENT_ID=
GHN_SERVICE_TYPE_ID=2                         # Loại dịch vụ GHN mặc định
GHN_REQUEST_TIMEOUT_MS=10000                  # Timeout request tới GHN

# ----------------------------------------------------------------------------
# 06. Demo mode và bản đồ mặc định
# ----------------------------------------------------------------------------
SHIPPING_DEMO_MODE=true                       # Cho phép luồng demo local
MAP_DEFAULT_LATITUDE=10.7769                  # Vĩ độ mặc định trên bản đồ demo
MAP_DEFAULT_LONGITUDE=106.7009                # Kinh độ mặc định trên bản đồ demo
