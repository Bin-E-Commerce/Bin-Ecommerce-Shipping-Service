{
  "name": "@bin-ecommerce/shipping-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json --incremental false",
    "start": "node --max-old-space-size=128 dist/services/shipping-service/src/main.js",
    "dev": "npm run build && node --watch dist/services/shipping-service/src/main.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc -p tsconfig.spec.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.7",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.7",
    "@nestjs/platform-express": "^11.0.7",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.1.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.1.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.22"
  },
  "devDependencies": {
    "@golevelup/ts-jest": "^3.0.0",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "multer": "2.4.0"
  }
}
